{
  "name": "PrettifyMyWebApi for Microsoft Dataverse",
  "version": "1.1.0.1",
  "description": "Open any row in the Dataverse Web Api and supercharge the output. Press to impress your coworkers!",
  "manifest_version": 3,
  "author": "Erik Donker",
  "browser_specific_settings": {
    "gecko": {
      "id": "prettifymywebapi@firefox-port.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {},
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "webRequestBlocking",
    "cookies"
  ],
  "host_permissions": [
    "*://*.dynamics.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.dynamics.com/api/data/*"
      ],
      "js": [
        "prettifyWebApi.js"
      ]
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
