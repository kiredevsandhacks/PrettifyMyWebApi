{
    "name": "PrettifyMyWebApi for Microsoft Dataverse",
    "version": "1.2.0.1",
    "description": "Open any row in the Dataverse/Dynamics 365 Web Api with pretty output. Edit and create rows. Quickly edit Power Automate Flows.",
    "manifest_version": 3,
    "author": "Erik Donker",
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "Ctrl+M": {
            "suggested_key": {
                "default": "Ctrl+M",
                "mac": "Command+M"
            },
            "description": "Ctrl+M."
        }
    },
    "action": {},
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "eventHandler.js",
                "libs/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://*.dynamics.com/api/data/*"
            ],
            "js": [
                "prettifyWebApi.js"
            ]
        }
    ],
    "icons": {
        "128": "icon128.png"
    }
}